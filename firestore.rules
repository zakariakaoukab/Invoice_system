rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ─────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ── users collection ─────────────────────────────────────────────────────
    // - All authenticated users can read their own document
    // - Only admins can create, update, or list all users

    match /users/{uid} {
      allow read: if isAuthenticated() && (isOwner(uid) || isAdmin());
      allow create: if isAuthenticated(); // Allow self-creation on setup wizard
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── products collection ──────────────────────────────────────────────────
    // - All authenticated users can read products
    // - Only admins can create, update, delete products

    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ── orders collection ────────────────────────────────────────────────────
    // - All authenticated users can create orders (must attach own UID)
    // - Standard users can only read their own orders
    // - Admins can read all orders

    match /orders/{orderId} {
      allow create: if isAuthenticated() &&
        request.resource.data.createdByUid == request.auth.uid;
      allow read: if isAuthenticated() &&
        (isAdmin() || resource.data.createdByUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ── counters collection (invoice numbering) ───────────────────────────────
    // - All authenticated users can read and update counters (for invoice ID generation)

    match /counters/{counterId} {
      allow read, write: if isAuthenticated();
    }
  }
}
